[CONFIG]
language = Seta
version = 7.0-Pro
encoding = utf-8

[VALID_COMMANDS]
# Uygulama Blok ve Özellik Yapısı (Tüm alanlar isteğe bağlıdır/boş bırakılabilir)
create app
app name "<uygulama_adi>"
app open id "<benzersiz_id_kodu>"
app paint "<hex_renk_kodu>"
app ico "<dosya_yolu.ico>"
app size "<genislikxyukseklik>"
app end

# Arayüz (UI) Elemanları
create text "<metin_icerigi>"
create input
create button "<buton_etiketi>"
create checkbox "<onay_kutusu_metni>"

# Ağ ve GitHub Senkronizasyon Komutları
connect seta "<github_raw_veya_url_adresi>"

[SYNTAX_RULES]
comment_symbol = #
rule_1 = Her komut yeni bir satırda yazılmalıdır.
rule_2 = Metin içeren komutlar çift tırnak "" arasına yazılmalıdır.
rule_3 = # ile başlayan satırlar yorum satiridir ve yorumlayıcı tarafından yoksayılır.
rule_4 = create app ile başlayan blok yapısı app end ile kapatılmalıdır.
rule_5 = Tüm app özellikleri isteğe bağlıdır; yazılmasa bile sistem varsayılan değerlerle çalışır.
rule_6 = Yeni eklenen app size ile pencere boyutu, create checkbox ile onay kutusu oluşturulabilir.

