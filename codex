[CONFIG]
language = Seta
version = 15.0-Ultimate-Hybrid
encoding = utf-8

[VALID_COMMANDS]
# 1. Uygulama ve Blok Yapısı
create app
app name "<uygulama_adi>"
app open id "<benzersiz_id>"
app paint "<hex_renk>"
app size "<genislikxyukseklik>"
app opacity "<saydamlik_orani>"
app end

# 2. HTML Hibrit Motoru (Tamamen HTML/CSS/JS ile Arayüz)
app html start
# Burada doğrudan HTML, CSS veya JavaScript kodları çalıştırılabilir.
app html end

# 3. Gelişmiş Buton ve Köşe (Radius) / Stil Yönetimi
create button "Buton Metni"
button radius "12px"
button bg "#3b82f6"
button fg "white"
button click "mesaj:Merhaba" 
# VEYA HTML parçasını tetiklemek için:
button click "html_ac:html_blok_adi"

# 4. Diğer Arayüz Bileşenleri
create text "Metin İçeriği"
create input
create checkbox "Onay Kutusu"
connect seta "<url>"
