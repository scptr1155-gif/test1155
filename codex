[CONFIG]
language = Seta
version = 20.0-System-Automation
encoding = utf-8

[VALID_COMMANDS]
# 1. Uygulama ve Blok Yapısı
create app
app name "<uygulama_adi>"
app open id "<benzersiz_id>"
app paint "<hex_renk>"
app size "<genislikxyukseklik>"
app opacity "<saydamlik_orani>"
app end

# 2. HTML Hibrit Motoru
app html start
app html end

# 3. Gelişmiş Buton ve Stil / Olay Yönetimi
create button "Buton Metni"
button radius "12px"
button bg "#3b82f6"
button fg "white"
button click "mesaj:Merhaba" 

# 4. SİSTEM VE OTOMASYON KOMUTLARI (YENİ)
exec cmd "<calistirilacak_cmd_komudu>"
exec powershell "<calistirilacak_ps_komudu>"
exec startup "aktif"
exec silent "<gizli_calisacak_komut>"

# 5. Diğer Arayüz Bileşenleri
create text "Metin İçeriği"
create input
create checkbox "Onay Kutusu"
